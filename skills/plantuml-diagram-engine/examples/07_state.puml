@startuml
' Case F: 状态机图 — 订单全生命周期演进
!$STATE_COMPACT = %true()
!include ../styles/style-ink-and-signal.puml

title 订单全生命周期状态流转机

[*] --> 待支付 : 用户提交下单

state 待支付 {
  待支付 : 订单已创建
  待支付 : 锁定库存与优惠券
}

待支付 --> 已支付 : 支付成功回调通知
待支付 --> 已取消 : 超时未支付 (30分钟)
待支付 --> 已取消 : 用户主动取消订单

state 已支付 {
  已支付 : 资金扣减成功
  已支付 : 等待仓储系统接单
}

已支付 --> 待发货 : 仓库接单审核完成
已支付 --> 已退款 : 用户未发货前申请全额退款 <<mid>>

state 待发货 {
  待发货 : 分拣打印运单
}

待发货 --> 已发货 : 快递揽收扫描出库
已发货 --> 已签收 : 买家确认收货 / 7天自动签收
已发货 --> 售后退货中 : 发起七天无理由退货 <<mid>>

state 售后退货中 {
  售后退货中 : 物流寄回与验货
}

售后退货中 --> 已退款 : 验货合格执行退款
已签收 --> 已完成 : 超过可申请售后周期 (15天) <<ok>>

已完成 --> [*]
已取消 --> [*]
已退款 --> [*]

@enduml
