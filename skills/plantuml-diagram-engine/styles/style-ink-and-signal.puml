' ═══════════════════════════════════════════════════════════════
' PlantUML Style · Ink & Signal  (v17)
' 设计语言：暖纸底 + 靛蓝墨色 + 信号黄；无阴影、1px 发丝线、宽松留白、语义色只用于风险
' 用法：!include 本文件
'   深色主题     !include 之前写  !$THEME = "dark"
'   正交连线     !include 之前写  !$LINETYPE = "ortho"      （默认 polyline）
'   状态图紧凑   !include 之前写  !$STATE_COMPACT = %true()  （会写入 hide empty description，
'                                                             该指令在甘特图等类型下非法，故默认关闭）
'   语义色       元素后加 <<low>> <<mid>> <<high>> <<ok>>；活动图可用 COLOR_RISK_HIGH_BG 等常量
'   Salt 线框   Salt 的文字/边框是硬编码黑色，样式无法改。深色主题下请在该图内加一行
'                skinparam backgroundColor #FAF8F3   （让它落在浅色底上）
'   SVG 嵌入     输出 SVG 已去掉固定宽高，页面里请用 CSS：width:100%; height:auto
'                （PlantUML 固定输出 preserveAspectRatio="none"，容器若同时限定宽高会被拉伸）
' ═══════════════════════════════════════════════════════════════

' ───────────────────────────────────────────────────────────────
' 〇、可注入参数（?= 表示：外部未定义时才使用默认值）
' ───────────────────────────────────────────────────────────────
!$THEME      ?= "light"
!$FONT_BODY  ?= "Noto Sans SC"
!$FONT_TITLE ?= "Noto Serif SC"
!$FONT_NOTE  ?= "LXGW WenKai Mono"
!$LINETYPE   ?= "polyline"
!$STATE_COMPACT ?= %false()

' ───────────────────────────────────────────────────────────────
' 一、设计令牌（Design Tokens）
' ───────────────────────────────────────────────────────────────
!if ($THEME == "dark")
  !$BG        = "#13111F"
  !$SURFACE   = "#1D1A33"
  !$SURFACE2  = "#26224A"
  !$GROUP     = "#171429"
  !$BORDER    = "#3E3868"
  !$INK       = "#EEEAFB"
  !$MUTED     = "#9C97B8"
  !$ARROW     = "#A8A2DA"
  !$ACCENT    = "#8E84F0"
  !$SIGNAL    = "#FFCD00"
  !$ON_ACCENT = "#13111F"
  !$NOTE_BG   = "#2C2710"
  !$NOTE_LINE = "#B8920A"
  !$NOTE_INK  = "#FFE58A"
  !$LOW_BG    = "#12302F"
  !$LOW_LINE  = "#4FB5BB"
  !$MID_BG    = "#3A2410"
  !$MID_LINE  = "#F5871F"
  !$HIGH_BG   = "#3C1618"
  !$HIGH_LINE = "#EF5B5C"
  !$OK_BG     = "#232C0B"
  !$OK_LINE   = "#9DBB1A"
!else
  !$BG        = "#FAF8F3"
  !$SURFACE   = "#FFFFFF"
  !$SURFACE2  = "#F1EEE6"
  !$GROUP     = "#F4F1E9"
  !$BORDER    = "#CFC9B8"
  !$INK       = "#1B1836"
  !$MUTED     = "#6B667E"
  !$ARROW     = "#4B4570"
  !$ACCENT    = "#211551"
  !$SIGNAL    = "#FFCD00"
  !$ON_ACCENT = "#FFFFFF"
  !$NOTE_BG   = "#FFF6D0"
  !$NOTE_LINE = "#E3B800"
  !$NOTE_INK  = "#5A4A00"
  !$LOW_BG    = "#E3F2F3"
  !$LOW_LINE  = "#2E7F85"
  !$MID_BG    = "#FDEEDC"
  !$MID_LINE  = "#C25E00"
  !$HIGH_BG   = "#F9E1E1"
  !$HIGH_LINE = "#C82829"
  !$OK_BG     = "#EBF0D6"
  !$OK_LINE   = "#5F7600"
!endif

' ───────────────────────────────────────────────────────────────
' 二、兼容常量（沿用原有命名，旧图无需改动）
' ───────────────────────────────────────────────────────────────
!define COLOR_DEFAULT_BACKGROUND $SURFACE
!define COLOR_ITP_DARK_BLUE    #211551
!define COLOR_ITP_YELLOW       #FFCD00
!define COLOR_ITP_Red          #c82829
!define COLOR_ITP_Orange       #f5871f
!define COLOR_ITP_Green        #718c00
!define COLOR_ITP_Aqua         #3e999f
!define COLOR_ITP_Purple       #8959a8
!define COLOR_ITP_BLACK #000000
!define COLOR_ITP_WHITE #ffffff
!define CurrentLine  #efefef
!define Selection    #d6d6d6
!define Foregound    #4d4d4c
!define Comment      #8e908c
!define COLOR_DEFAULT_TEXT $INK
!define FONT_FIRA_MONO $FONT_BODY
!define FONT_FIRA_SANS $FONT_BODY
!define TITLE_FONT $FONT_TITLE
!define NOTE_COMMENT_FONT $FONT_NOTE

' ───────────────────────────────────────────────────────────────
' 三、全局基础
' ───────────────────────────────────────────────────────────────
skinparam defaultFontName $FONT_BODY
skinparam defaultFontSize 13
skinparam defaultFontStyle plain
skinparam defaultFontColor $INK
skinparam backgroundColor $BG
skinparam roundCorner 10
skinparam shadowing false
skinparam dpi 160
skinparam svgDimensionStyle false
skinparam minClassWidth 90
skinparam nodesep 56
skinparam ranksep 68
' v17.1: obsolete global skinparam padding removed (the renderer draws a warning banner)
skinparam linetype $LINETYPE
skinparam componentStyle rectangle
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 220
!pragma svginteractive true
skinparam pathHoverColor $MID_LINE
skinparam packageTitleAlignment left

' 3.1 标题 / 表头 / 表尾 / 图例
skinparam title {
  FontName $FONT_TITLE
  FontSize 26
  FontStyle bold
  FontColor $INK
  HorizontalAlignment left
  BorderThickness 0
}
skinparam header {
  HorizontalAlignment left
  FontSize 11
  FontColor $MUTED
}
skinparam footer {
  HorizontalAlignment right
  FontSize 10
  FontColor $MUTED
}
skinparam legend {
  BackgroundColor $SURFACE
  BorderColor $BORDER
  FontSize 11
  FontColor $INK
}

' 3.2 笔记（便签黄）
skinparam note {
  BackgroundColor $NOTE_BG
  BorderColor $NOTE_LINE
  BorderThickness 1
  FontName $FONT_NOTE
  FontSize 11
  FontColor $NOTE_INK
}

' 3.3 箭头
skinparam arrow {
  Color $ARROW
  Thickness 1
  FontColor $INK
  FontSize 12
}

' 3.4 实体 / 通用容器
skinparam entity {
  BackgroundColor $SURFACE
  BorderColor $ACCENT
  BorderThickness 1
}
skinparam package {
  BackgroundColor $GROUP
  BorderColor $BORDER
  BorderThickness 1
  FontColor $INK
  FontStyle bold
  FontSize 12
}

' ───────────────────────────────────────────────────────────────
' 四、各类图
' ───────────────────────────────────────────────────────────────
' 4.1 活动图
skinparam activity {
  StartColor $SIGNAL
  EndColor $INK
  BarColor $ACCENT
  BackgroundColor $SURFACE
  BorderColor $ACCENT
  BorderThickness 1
  ArrowColor $ARROW
  FontColor $INK
}
skinparam activityEnd {
  BackgroundColor $OK_BG
  BorderColor $OK_LINE
}
skinparam activityDecision {
  BackgroundColor $SURFACE2
  BorderColor $ACCENT
}
skinparam activityDiamond {
  BackgroundColor $SURFACE2
  BorderColor $ACCENT
  FontSize 12
  FontColor $INK
}
skinparam partition {
  BackgroundColor $GROUP
  BorderColor $BORDER
  FontColor $INK
}
skinparam swimlane {
  BorderColor $BORDER
  BorderThickness 1
  TitleBackgroundColor $SURFACE2
  TitleFontColor $INK
}

' 4.2 类图
skinparam class {
  BackgroundColor $SURFACE
  BorderColor $ACCENT
  BorderThickness 1
  ArrowColor $ARROW
  HeaderBackgroundColor $SURFACE2
  AttributeFontColor $INK
  AttributeIconSize 0
  FontStyle bold
}
skinparam circledCharacterFontColor $INK
skinparam circledCharacterFontSize 11
skinparam circledCharacterRadius 9
skinparam stereotypeCBackgroundColor $SURFACE2
skinparam stereotypeCBorderColor $ACCENT
skinparam stereotypeIBackgroundColor $LOW_BG
skinparam stereotypeIBorderColor $LOW_LINE
skinparam stereotypeEBackgroundColor $MID_BG
skinparam stereotypeEBorderColor $MID_LINE
skinparam stereotypeABackgroundColor $NOTE_BG
skinparam stereotypeABorderColor $NOTE_LINE

' 4.3 用例图
skinparam usecase {
  BackgroundColor $SURFACE
  BorderColor $ACCENT
  BorderThickness 1
  ArrowColor $ARROW
}
skinparam actor {
  BackgroundColor $SURFACE
  BorderColor $ACCENT
  FontColor $INK
}

' 4.4 状态图
skinparam state {
  BackgroundColor $SURFACE
  BorderColor $ACCENT
  BorderThickness 1
  StartColor $SIGNAL
  EndColor $INK
  ArrowColor $ARROW
}

!if ($STATE_COMPACT == %true())
  hide empty description
!endif

' 4.5 时序图
skinparam sequence {
  ArrowColor $ARROW
  ArrowThickness 1
  ArrowFontColor $INK
  ActorBackgroundColor $SURFACE
  ActorBorderColor $ACCENT
  ParticipantBackgroundColor $SURFACE
  ParticipantBorderColor $ACCENT
  ParticipantBorderThickness 1
  ParticipantFontColor $INK
  ParticipantPadding 24
  LifeLineBorderColor $BORDER
  LifeLineBackgroundColor $SURFACE2
  GroupBorderColor $BORDER
  GroupBackgroundColor $ACCENT
  GroupBodyBackgroundColor transparent
  GroupHeaderFontColor $ON_ACCENT
  GroupFontColor $INK
  DividerBorderColor $BORDER
  DividerBackgroundColor $SURFACE2
  ReferenceBackgroundColor $SURFACE2
  ReferenceBorderColor $BORDER
  BoxBorderColor $BORDER
  BoxBackgroundColor $GROUP
  MessageAlignment direction
}

' ───────────────────────────────────────────────────────────────
' 五、组件图及其余元素：通用宏
' ───────────────────────────────────────────────────────────────
!procedure $common_style($name, $bg=$SURFACE, $fontsize=12, $fontcolor=$INK, $line=$ACCENT)
  skinparam $name {
    BackgroundColor $bg
    BorderColor $line
    BorderThickness 1
    ArrowColor $ARROW
    FontSize $fontsize
    FontColor $fontcolor
  }
!endprocedure

!$leaf = %splitstr("actor~agent~artifact~boundary~card~circle~collections~component~control~database~entity~file~hexagon~interface~label~queue~stack~storage~usecase~cloud~node", "~")
!foreach $item in $leaf
  %invoke_procedure("$common_style", $item)
!endfor

' 容器类元素：低对比分组面
!$groups = %splitstr("folder~frame~package~rectangle", "~")
!foreach $item in $groups
  %invoke_procedure("$common_style", $item, $GROUP, 12, $INK, $BORDER)
!endfor

' ───────────────────────────────────────────────────────────────
' 六、语义构造型：<<low>> <<mid>> <<high>> <<ok>>
' ───────────────────────────────────────────────────────────────
!define COLOR_RISK_LOW_BG    $LOW_BG
!define COLOR_RISK_LOW_LINE  $LOW_LINE
!define COLOR_RISK_MID_BG    $MID_BG
!define COLOR_RISK_MID_LINE  $MID_LINE
!define COLOR_RISK_HIGH_BG   $HIGH_BG
!define COLOR_RISK_HIGH_LINE $HIGH_LINE
!define COLOR_RISK_OK_BG     $OK_BG
!define COLOR_RISK_OK_LINE   $OK_LINE

!procedure $semantic($name)
  skinparam $name<<low>> {
    BackgroundColor $LOW_BG
    BorderColor $LOW_LINE
  }
  skinparam $name<<mid>> {
    BackgroundColor $MID_BG
    BorderColor $MID_LINE
  }
  skinparam $name<<high>> {
    BackgroundColor $HIGH_BG
    BorderColor $HIGH_LINE
  }
  skinparam $name<<ok>> {
    BackgroundColor $OK_BG
    BorderColor $OK_LINE
  }
!endprocedure

!$sem_targets = %splitstr("rectangle~class~component~card~usecase~state~node~cloud~database~queue~entity~interface~hexagon~agent~artifact~file~folder~frame~storage~stack~label~collections~boundary~control~package", "~")
!foreach $item in $sem_targets
  %invoke_procedure("$semantic", $item)
!endfor
skinparam stereotypeFontColor $MUTED
skinparam archimateFontColor #1B1836
skinparam archimateStereotypeFontColor #4B4570

' ───────────────────────────────────────────────────────────────
' 七、style 精修（skinparam 无法表达的部分）
' ───────────────────────────────────────────────────────────────
<style>
' 全局兜底：只设文字色与链接色。
' 注意：不要在 root 里设 LineColor / BackGroundColor —— 它们会压过起止节点、类表头、分组容器等
' 更具体的 skinparam 配色（v9~v12 曾因此回退）。
root {
  FontColor $INK
  HyperLinkColor $ACCENT
}
document {
  ' 底部留白：甘特图等类型的最后一行文字会贴边被裁（引擎自身行为，放大字号后更明显）
  Margin 8 8 18 8
  title {
    FontName $FONT_TITLE
    FontSize 26
    FontStyle bold
    FontColor $INK
    Margin 4 0 18 0
    LineColor transparent
    BackGroundColor transparent
  }
  header {
    HorizontalAlignment left
    FontSize 11
    FontColor $MUTED
    LineColor transparent
    BackGroundColor transparent
  }
  footer {
    HorizontalAlignment right
    FontSize 10
    FontColor $MUTED
    LineColor transparent
    BackGroundColor transparent
  }
  caption {
    FontSize 11
    FontColor $MUTED
    LineColor transparent
    BackGroundColor transparent
  }
}
document {
  BackgroundColor $BG
}
' 描述类图（组件 / 部署 ...）中各类元素的文字居中，按类型逐个列出。
' 不能用 skinparam defaultTextAlignment center，也不能用 element { ... }，
' 更不能在顶层写 node { ... }：WBS / 思维导图的节点也叫 node，会被一并居中而溢出（已三次复现）。
rectangle {
  HorizontalAlignment center
}
component {
  HorizontalAlignment center
}
database {
  HorizontalAlignment center
}
cloud {
  HorizontalAlignment center
}
queue {
  HorizontalAlignment center
}
card {
  HorizontalAlignment center
}
storage {
  HorizontalAlignment center
}
artifact {
  HorizontalAlignment center
}
agent {
  HorizontalAlignment center
}
hexagon {
  HorizontalAlignment center
}
stack {
  HorizontalAlignment center
}
file {
  HorizontalAlignment center
}
label {
  HorizontalAlignment center
}
collections {
  HorizontalAlignment center
}
control {
  HorizontalAlignment center
}
boundary {
  HorizontalAlignment center
}
folder {
  HorizontalAlignment center
}
frame {
  HorizontalAlignment center
}
componentDiagram {
  node {
    HorizontalAlignment center
  }
}

' 思维导图 / WBS：根节点实心，一级浅底，叶子白底
mindmapDiagram {
  node {
    BackgroundColor $SURFACE
    LineColor $ACCENT
    LineThickness 1
    FontColor $INK
    RoundCorner 12
    Padding 8
    Margin 6
  }
  rootNode {
    BackgroundColor $ACCENT
    LineColor $ACCENT
    FontColor $ON_ACCENT
    FontStyle bold
    FontSize 15
  }
  :depth(1) {
    BackgroundColor $SURFACE2
    FontStyle bold
  }
  arrow {
    LineColor $ARROW
    LineThickness 1
  }
}
wbsDiagram {
  node {
    BackgroundColor $SURFACE
    LineColor $ACCENT
    LineThickness 1
    FontColor $INK
    RoundCorner 10
    Padding 8
  }
  rootNode {
    BackgroundColor $ACCENT
    LineColor $ACCENT
    FontColor $ON_ACCENT
    FontStyle bold
  }
  :depth(1) {
    BackgroundColor $SURFACE2
    FontStyle bold
  }
  arrow {
    LineColor $ARROW
    LineThickness 1
  }
}

' 甘特图
ganttDiagram {
  FontSize 12
  FontColor $INK
  task {
    BackgroundColor $LOW_BG
    LineColor $LOW_LINE
    LineThickness 1
    FontColor $INK
    RoundCorner 6
  }
  milestone {
    BackgroundColor $SIGNAL
    LineColor $INK
    LineThickness 1
  }
  timeline {
    BackgroundColor $SURFACE2
    FontSize 11
    FontColor $MUTED
    LineColor $BORDER
  }
  separator {
    LineColor $BORDER
    FontColor $MUTED
  }
  note {
    BackgroundColor $NOTE_BG
    LineColor $NOTE_LINE
    FontColor $NOTE_INK
  }
  arrow {
    LineColor $ARROW
  }
}

' JSON / YAML
jsonDiagram {
  node {
    BackgroundColor $SURFACE
    LineColor $ACCENT
    LineThickness 1
    FontColor $INK
    RoundCorner 6
    Padding 4
  }
  highlight {
    BackgroundColor $NOTE_BG
    FontColor $NOTE_INK
    FontStyle bold
  }
  arrow {
    LineColor $ARROW
  }
}
yamlDiagram {
  node {
    BackgroundColor $SURFACE
    LineColor $ACCENT
    LineThickness 1
    FontColor $INK
    RoundCorner 6
  }
  highlight {
    BackgroundColor $NOTE_BG
    FontColor $NOTE_INK
    FontStyle bold
  }
  arrow {
    LineColor $ARROW
  }
}

' ArchiMate：元素填充色是引擎写死的浅色，文字必须是深色（深色主题下 root.FontColor 为浅色会不可读）
archimate {
  FontColor #1B1836
}

' 时序图分组 / 引用：新样式引擎默认黑线灰底；标题条用强调色底 + 反色文字，外框同色
sequenceDiagram {
  group {
    LineColor $ACCENT
    LineThickness 1
  }
  groupHeader {
    BackGroundColor $ACCENT
    LineColor $ACCENT
    LineThickness 1
    FontColor $ON_ACCENT
  }
  reference {
    LineColor $BORDER
    LineThickness 1
  }
  referenceHeader {
    BackGroundColor $SURFACE2
    LineColor $BORDER
    LineThickness 1
    FontColor $INK
  }
}

' 起止节点：引擎默认写死 #222（深色主题下终点几乎不可见），且不受 EndColor 控制
activityDiagram {
  circle {
    start {
      BackgroundColor $SIGNAL
      LineColor $INK
    }
    stop {
      BackgroundColor $INK
      LineColor $INK
    }
    end {
      BackgroundColor $INK
      LineColor $INK
    }
  }
}
stateDiagram {
  circle {
    start {
      BackgroundColor $SIGNAL
      LineColor $INK
    }
    stop {
      BackgroundColor $INK
      LineColor $INK
    }
    end {
      BackgroundColor $INK
      LineColor $INK
    }
  }
}

' 时序（Timing）
timingDiagram {
  LineColor $ACCENT
  FontColor $INK
  timeline {
    FontColor $MUTED
    LineColor $BORDER
  }
  clock {
    LineColor $ACCENT
  }
  concise {
    LineColor $ACCENT
    BackgroundColor $SURFACE2
  }
  robust {
    LineColor $ACCENT
    BackgroundColor $SURFACE2
  }
  binary {
    LineColor $ACCENT
  }
  arrow {
    FontName $FONT_BODY
    FontColor $ARROW
    LineColor $ARROW
  }
  constraintArrow {
    FontName $FONT_BODY
    FontColor $HIGH_LINE
    LineColor $HIGH_LINE
  }
  highlight {
    BackgroundColor $NOTE_BG
    LineColor $NOTE_LINE
  }
}

' 网络拓扑（nwdiag）
nwdiagDiagram {
  network {
    BackgroundColor $SURFACE2
    LineColor $BORDER
    FontColor $INK
  }
  server {
    BackgroundColor $SURFACE
    LineColor $ACCENT
    FontColor $INK
  }
  group {
    BackgroundColor $GROUP
    LineColor $BORDER
  }
  arrow {
    LineColor $ARROW
  }
}
</style>