@startuml
' 顺序步骤 → Activity（不强行套状态图）
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
  ArrowColor #94A3B8
  StartColor #2563EB
  EndColor #172554
}
title 早晨日程
start
:起床;
:洗漱;
:早饭;
:上班;
stop
@enduml
