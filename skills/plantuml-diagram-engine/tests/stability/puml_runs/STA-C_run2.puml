@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
  ArrowColor #94A3B8
}
[*] --> 已创建
已创建 --> 待支付 : 下单确认
待支付 --> 已支付 : 支付成功
待支付 --> 已关闭 : 超时
已支付 --> 备货中 : 备货
备货中 --> 已发货 : 出库
已发货 --> 已签收 : 签收
已签收 --> 退款申请 : 申请退款
退款申请 --> 退款中 : 审批
退款中 --> 已关闭 : 退款完成
已关闭 --> [*]
@enduml
