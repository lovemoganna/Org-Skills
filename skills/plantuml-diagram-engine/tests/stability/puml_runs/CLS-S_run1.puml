@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
  ArrowColor #94A3B8
  HeaderBackgroundColor #DBEAFE
}
class User {
  + id : Long
  + name : String
  + email : String
}
class Order {
  + id : Long
  + status : String
  + createdAt : Date
}
User "1" --> "0..*" Order : 拥有
@enduml
