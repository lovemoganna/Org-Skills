@startuml
' 模糊输入，最小假设
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
  ArrowColor #94A3B8
}
