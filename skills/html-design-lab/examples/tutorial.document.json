    {
      "id": "section-3",
      "title": "编写 SQL",
      "subtitle": "",
      "blocks": [
        {
          "type": "code",
          "language": "sql",
          "code": "SELECT category, COUNT(*) AS txn_count, SUM(amount) AS total_amount\nFROM (VALUES ('A', 100), ('A', 60), ('B', 40)) AS t(category, amount)\nGROUP BY category\nORDER BY total_amount DESC;"
        }
      ]
    },
